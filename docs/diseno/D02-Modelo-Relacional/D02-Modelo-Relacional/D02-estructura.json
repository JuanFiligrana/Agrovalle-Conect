      },
      {
        "name": "id_agricultor",
        "type": "BIGINT",
        "flags": [
          "FK",
          "NN"
        ],
        "ref": "agricultor.id_usuario",
        "default": null,
        "description": "Único agricultor que atiende este pedido."
      },
      {
        "name": "fecha_confirmacion",
        "type": "TIMESTAMPTZ",
        "flags": [
          "NN"
        ],
        "ref": null,
        "default": "CURRENT_TIMESTAMP",
        "description": ""
      },
      {
        "name": "estado",
        "type": "VARCHAR(24)",
        "flags": [
          "NN"
        ],
        "ref": null,
        "default": "'PENDIENTE'",
        "description": ""
      },
      {
        "name": "fecha_completado",
        "type": "TIMESTAMPTZ",
        "flags": [],
        "ref": null,
        "default": null,
        "description": "Obligatoria solo cuando el pedido está ENTREGADO."
      }
    ],
    "pk": [
      "id_pedido"
    ],
    "unique": [],
    "checks": [
      "estado IN ('PENDIENTE','LISTO_PARA_DESPACHO','EN_CAMINO','ENTREGADO','CANCELADA')",
      "((estado = 'ENTREGADO' AND fecha_completado IS NOT NULL) OR (estado <> 'ENTREGADO' AND fecha_completado IS NULL))",
      "fecha_completado >= fecha_confirmacion"
    ],
    "note": "No repite id_comprador ni total. Clave de reintento en idempotencia_pedido; total se calcula en una vista."
  },
