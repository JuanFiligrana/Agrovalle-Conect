        <mxCell id="p3_61" value="Restricción de exclusión: cada notificación procede de CONTACTO o de EVENTO_SEGUIMIENTO, de exactamente uno de los dos." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
