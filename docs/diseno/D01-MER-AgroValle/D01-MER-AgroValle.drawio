        </mxCell>
        <mxCell id="p0_4" value="Lectura: (mín., máx.) junto a una entidad = cuántas veces participa cada instancia en esa relación." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=19;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
