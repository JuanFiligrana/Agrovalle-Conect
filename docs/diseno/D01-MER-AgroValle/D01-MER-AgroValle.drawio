        <mxCell id="p1_38" value="AGRICULTOR y COMPRADOR heredan id_usuario y los datos comunes." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1210" width="820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1_39" value="UQ: la cédula del agricultor y el correo de usuario son únicos." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1270" width="820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1_40" value="Decisión de diseño: cada cuenta pertenece a un solo rol." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1330" width="820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1_41" value="Si se requieren cuentas multirrol, se revisará esta especialización." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1390" width="820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1_42" value="El municipio de residencia puede diferir del municipio de la finca." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1510" width="820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1_43" value="La doble línea hacia ISA indica que toda cuenta pertenece a uno de los dos subtipos. La contraseña se almacena como hash." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
