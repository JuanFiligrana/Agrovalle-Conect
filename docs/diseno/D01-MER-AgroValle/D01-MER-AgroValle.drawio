        </mxCell>
        <mxCell id="p3_62" value="El destinatario del aviso de contacto es el agricultor dueño de la cosecha. La fecha del contacto no es la fecha del envío." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
