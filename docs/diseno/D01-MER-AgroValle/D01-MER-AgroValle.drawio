        </mxCell>
        <mxCell id="p4_91" value="Cada pedido conserva el comprador de su carrito de origen y pertenece a un solo agricultor. Todas sus líneas deben corresponder a ese agricultor." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="2170" width="2630" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p4_92" value="RESERVA es el ítem del carrito: activa, consumida o vencida. Al confirmar, genera un detalle con cantidad y precio histórico inmutables." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
