        <mxCell id="p2_65" value="COSECHA representa la oferta vendible de una finca. PRODUCTO identifica el tipo de producto, por ejemplo Café o Papa." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
