        <mxCell id="p5_39" value="Eventos del pedido: PENDIENTE → LISTO_PARA_DESPACHO → EN_CAMINO → ENTREGADO; PENDIENTE → CANCELADA." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1510" width="2200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p5_40" value="El envío es opcional mientras el pedido está pendiente. La trazabilidad se conserva incluso si el pedido se cancela antes del despacho." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1570" width="2200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p5_41" value="HU-03 · Decisión de diseño: una transacción completada es una línea de pedido ENTREGADO, con su precio histórico en COP/kg." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1650" width="2200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p5_42" value="Promedio de producto = suma de precios unitarios de esas líneas / número de líneas, con fecha_completado en las últimas 24 horas." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1700" width="2200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p5_43" value="Promedio no ponderado; redondeo a 2 decimales. Sin ventas: promedio null y cantidad 0. No se requieren pagos reales ni GPS." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
