        </mxCell>
        <mxCell id="p0_5" value="Clave subrayada · Óvalo discontinuo: atributo calculado · Gris: entidad repetida de otra vista · N: muchos" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=18;fontColor=#526477;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
