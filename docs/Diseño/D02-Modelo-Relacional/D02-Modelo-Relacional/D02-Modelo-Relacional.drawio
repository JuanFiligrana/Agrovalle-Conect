        <mxCell id="note0" value="COSECHA no repite id_municipio, id_agricultor ni id_categoria: se obtienen siguiendo las FK." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1580" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="La cantidad disponible y el precio promedio de las últimas 24 horas se calculan; no son columnas base." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1640" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Cantidad física permite cero tras agotar existencias. Publicar exige cantidad inicial positiva en el servicio." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1700" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="PK: primaria · FK: foránea · UQ: única · NN / Nulo NO: obligatorio · UQ*: índice único sobre correo normalizado" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=19;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1759" width="2760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Extremos: 1 = uno; 0..1 = opcional; 0..N = varios; 1..N = uno o más. Los mínimos de colecciones requieren la operación transaccional." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=18;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1798" width="2760" height="30" as="geometry" />
        </mxCell>
