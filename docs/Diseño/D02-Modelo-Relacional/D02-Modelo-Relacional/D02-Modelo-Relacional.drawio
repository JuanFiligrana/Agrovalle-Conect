        </mxCell>
        <mxCell id="note1" value="El servicio crea contacto y aviso en la misma transacción y valida que el destinatario sea el correcto." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1800" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="El agricultor receptor del contacto se obtiene por contacto → cosecha → finca; se evita una dependencia transitiva." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1860" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="PK: primaria · FK: foránea · UQ: única · NN / Nulo NO: obligatorio · UQ*: índice único sobre correo normalizado" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=19;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1909" width="2760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Extremos: 1 = uno; 0..1 = opcional; 0..N = varios; 1..N = uno o más. Los mínimos de colecciones requieren la operación transaccional." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=18;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
