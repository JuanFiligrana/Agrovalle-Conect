        <mxCell id="note0" value="CHECK XOR: exactamente uno de id_contacto e id_evento debe tener valor. El otro queda NULL." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
