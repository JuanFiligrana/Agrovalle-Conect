        <mxCell id="cosecha_ref" value="REFERENCIA · columnas seleccionadas de otra vista" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=17;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
