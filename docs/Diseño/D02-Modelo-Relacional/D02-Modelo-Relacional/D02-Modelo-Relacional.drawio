        </mxCell>
        <mxCell id="note0" value="Los eventos conservan los estados históricos y su fecha; el estado actual del pedido se valida en el servicio." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1510" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Estados: PENDIENTE → LISTO_PARA_DESPACHO → EN_CAMINO → ENTREGADO, o PENDIENTE → CANCELADA." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1570" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="La programación futura del envío se comprueba al realizar la operación; no se usa un CHECK que dependa de hoy." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1630" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="PK: primaria · FK: foránea · UQ: única · NN / Nulo NO: obligatorio · UQ*: índice único sobre correo normalizado" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=19;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1759" width="2760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Extremos: 1 = uno; 0..1 = opcional; 0..N = varios; 1..N = uno o más. Los mínimos de colecciones requieren la operación transaccional." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=18;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1798" width="2760" height="30" as="geometry" />
        </mxCell>
