        </mxCell>
        <mxCell id="note0" value="PK compuesta: (id_comprador, clave). id_pedido es también único; el servicio comprueba que pertenezca al mismo comprador." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1400" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="v_disponibilidad: cantidad física − reservas activas no vencidas. No se almacena una copia del resultado." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1470" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="v_total_pedido: suma de subtotales, con cada línea redondeada a dos decimales en COP." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1530" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="v_precios_24h: promedio no ponderado del precio histórico de líneas entregadas en 24 horas; sin ventas: NULL y cantidad 0." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1590" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="Las vistas son consultas. No cuentan como tablas base adicionales ni se editan como datos del negocio." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1650" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="PK: primaria · FK: foránea · UQ: única · NN / Nulo NO: obligatorio · UQ*: índice único sobre correo normalizado" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=19;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1759" width="2760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Extremos: 1 = uno; 0..1 = opcional; 0..N = varios; 1..N = uno o más. Los mínimos de colecciones requieren la operación transaccional." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=18;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1798" width="2760" height="30" as="geometry" />
        </mxCell>
