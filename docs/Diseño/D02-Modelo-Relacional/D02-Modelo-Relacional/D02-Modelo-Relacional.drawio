        <mxCell id="note0" value="UNIQUE(id_reserva) evita que una misma reserva origine dos detalles. La oferta no se vuelve a copiar en detalle_pedido." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1880" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="El pedido obtiene su comprador mediante carrito. El servicio conserva la propiedad del carrito y el agricultor único del pedido." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1940" width="2760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Confirmación, consumo de reservas y descuento de stock deben ser una operación atómica; D02 define su estructura de datos." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#526477;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
