mily=DejaVu Sans;fontSize=22;fontColor=#24364a;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="db_local"><mxGeometry x="16" y="39" width="1270" height="36" as="geometry" /></mxCell><mxCell id="text18" value="El modelo D02 se debe instalar y conectar al backend en otro paso" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontColor=#536579;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="db_local"><mxGeometry x="20" y="82" width="1275" height="45" as="geometry" /></mxCell><mxCell id="text19" value="Actual en el código: server.port=${PORT:8081}; repositorios en memoria, sin datasource JPA configurado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=20;fontColor=#24364a;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1860" width="1860" height="42" as="geometry" /></mxCell><mxCell id="text20" value="Línea continua: comunicación configurada por el prototipo. Discontinua: dependencia de integración prevista.&#10;La presencia del driver PostgreSQL en Maven no demuestra que el proyecto ya esté conectado a una base de datos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontColor=#536579;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1915" width="1860" height="65" as="geometry" /></mxCell><mxCell id="text21" value="El diagrama no afirma que agrovalle_db ya exista. La implementación técnica se realizará después del diseño." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontColor=#536579;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="2010" width="1860" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>