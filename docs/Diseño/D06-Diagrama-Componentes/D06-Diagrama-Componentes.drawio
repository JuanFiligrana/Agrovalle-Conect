"edgeStyle=none;rounded=0;dashed=1;strokeColor=#52677e;strokeWidth=2.3;endArrow=block;endFill=0;exitX=0.19736842105263158;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="business" target="cases"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="edgeStyle=none;rounded=0;dashed=1;strokeColor=#52677e;strokeWidth=2.3;endArrow=open;endFill=0;exitX=0.19736842105263158;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="business" target="cosecha_port"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="" style="edgeStyle=none;rounded=0;dashed=1;strokeColor=#52677e;strokeWidth=2.3;endArrow=block;endFill=0;exitX=0.19736842105263158;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="persistence" target="cosecha_port"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="" style="edgeStyle=none;rounded=0;dashed=1;strokeColor=#52677e;strokeWidth=2.3;endArrow=open;endFill=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="persistence" target="sql"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge11" value="" style="edgeStyle=none;rounded=0;dashed=1;strokeColor=#52677e;strokeWidth=2.3;endArrow=block;endFill=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="database" target="sql"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="text0" value="D06 / Componentes de AgroValle Connect" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=36;fontStyle=1;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="45" width="2460" height="60" as="geometry" /></mxCell><mxCell id="text1" value="Diseño objetivo modular · Componentes e interfaces de un backend Spring Boot · HU01–05 y apoyo de fincas" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=0;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="115" width="2460" height="55" as="geometry" /></mxCell><mxCell id="text2" value="Flecha abierta discontinua: usa o requiere · Triángulo vacío discontinuo: realiza o proporciona la interfaz" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="2720" width="2460" height="42" as="geometry" /></mxCell><mxCell id="text3" value="Los nombres de interfaces generales resumen contratos del diseño. JWT, JPA y PostgreSQL siguen por implementar.&#10;CosechaPort se muestra como ejemplo; la hoja 02 despliega el detalle de los contratos de datos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=20;fontStyle=0;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="2780" width="2460" height="60" as="geometry" /></mxCell><mxCell id="text4" value="«package» backend Spring Boot · un solo JAR" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="backend"><mxGeometry x="14" y="4" width="1532" height="32" as="geometry" /></mxCell><mxCell id="text5" value="«component»" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#245e96;strokeColor=none;fillColor=none;" vertex="1" parent="web"><mxGeometry x="20" y="10" width="490" height="28" as="geometry" /></mxCell><mxCell id="text6" value="Interfaz web" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=25;fontStyle=1;fontColor=#245e96;strokeColor=none;fillColor=none;" vertex="1" parent="web"><mxGeometry x="20" y="50" width="560" height="47" as="geometry" /></mxCell><mxCell id="text7" value="HTML, CSS y JavaScript&#10;Formularios previstos en D07&#10;Ejecución en el navegador" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=20;fontStyle=0;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="web"><mxGeometry x="24" y="105" width="552" height="110" as="geometry" /></mxCell><mxCell id="text8" value="Cómo leer las interfaces" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="reading_note"><mxGeometry x="20" y="12" width="730" height="40" as="geometry" /></mxCell><mxCell id="text9" value="El consumidor usa un contrato.&#10;El proveedor lo implementa.&#10;Ambas relaciones apuntan a la interfaz.&#10;Las interfaces generales son contratos conceptuales." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="reading_note"><mxGeometry x="20" y="60" width="735" height="255" as="geometry" /></mxCell><mxCell id="text10" value="Correspondencia con D03" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="layers_note"><mxGeometry x="20" y="12" width="730" height="40" as="geometry" /></mxCell><mxCell id="text11" value="Presentación: interfaz web y API.&#10;Negocio: casos de uso.&#10;Acceso a datos: persistencia JPA.&#10;Persistencia relacional: PostgreSQL.&#10;Models y DTO representan tipos de datos compartidos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="layers_note"><mxGeometry x="20" y="60" width="735" height="295" as="geometry" /></mxCell><mxCell id="text12" value="Correspondencia con D05" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="sequence_note"><mxGeometry x="20" y="12" width="730" height="40" as="geometry" /></mxCell><mxCell id="text13" value="api:Presentacion se corresponde con la API.&#10;negocio:Servicio está en los casos de uso.&#10;datos:Persistencia agrupa los adaptadores.&#10;bd:PostgreSQL es el componente externo.&#10;El servicio coordina la transacción de contacto y aviso." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#586b7f;strokeColor=none;fillColor=none;" vertex="1" parent="sequence_note"><mxGeometry x="20" y="60" width="735" height="275" as="geometry" /></mxCell><mxCell id="text14" value="«interface»" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#245e96;strokeColor=none;fillColor=none;" vertex="1" parent="http"><mxGeometry x="16" y="9" width="188" height="28" as="geometry" /></mxCell><mxCell id="text15" value="HTTP&#10;AgroValle" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#245e96;strokeColor=none;fillColor=none;" vertex="1" parent="http"><mxGeometry x="18" y="44" width="184" height="60" as="geometry" /></mxCell><mxCell id="text16" value="HTML / JSON" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#26384b;strokeColor=none;fillColor=none;" vertex="1" parent="http"><mxGeometry x="18" y="112" width="184" height="56" as="geometry" /></mxCell><mxCell id="text17" value="«compo