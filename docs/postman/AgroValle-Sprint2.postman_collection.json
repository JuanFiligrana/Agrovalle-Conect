{
  "info": {
    "name": "AgroValle Connect · Sprint 2",
    "description": "Demostración reproducible de HU-02, HU-04, Observer y Strategy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('suffix')) {",
          "  const suffix = Date.now().toString();",
          "  pm.collectionVariables.set('suffix', suffix);",
          "  pm.collectionVariables.set('correo', `sprint2-${suffix}@agrovalle.test`);",
          "  pm.collectionVariables.set('cedula', suffix);",
          "}",
          "const fecha = new Date();",
          "fecha.setUTCDate(fecha.getUTCDate() + 1);",
          "pm.collectionVariables.set('fechaCosecha', fecha.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081"},
    {"key": "correo", "value": ""},
    {"key": "cedula", "value": ""},
    {"key": "suffix", "value": ""},
    {"key": "token", "value": ""},
    {"key": "fincaId", "value": ""},
    {"key": "cosechaId", "value": ""},
    {"key": "fechaCosecha", "value": ""}
  ],
  "item": [
    {
      "name": "1 · Registrar agricultor",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Agricultor Sprint 2\",\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"secreto123\",\n  \"cedula\": \"{{cedula}}\",\n  \"ubicacionValle\": \"Cali\",\n  \"rol\": \"AGRICULTOR\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "2 · Iniciar sesión",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('JWT recibido', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token', pm.response.json().accessToken);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"secreto123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "3 · Crear finca",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Finca creada', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('fincaId', pm.response.json().id);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Sprint 2\",\n  \"municipio\": \"Dagua\",\n  \"descripcion\": \"Origen de la demostración\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/fincas"
      }
    },
    {
      "name": "4 · Publicar cosecha · HU-02",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Cosecha creada', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('cosechaId', pm.response.json().id);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fincaId\": {{fincaId}},\n  \"tipo\": \"Mango\",\n  \"categoria\": \"Frutas\",\n  \"cantidadKg\": 250,\n  \"precioCopKg\": 3500,\n  \"fechaCosecha\": \"{{fechaCosecha}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/productos"
      }
    },
    {
      "name": "5 · Filtrar cosechas · HU-04",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/productos?municipio=Dagua&categoria=Frutas"
      }
    },
    {
      "name": "6 · Consultar aviso · Observer",
      "request": {
        "method": "GET",
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
        "url": "{{baseUrl}}/api/v1/notificaciones/cosechas"
      }
    },
    {
      "name": "7 · Calcular flete · Strategy",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/fletes/calculo?municipio=Dagua&subtotal=100000"
      }
    }
  ]
}
